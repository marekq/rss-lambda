{
  "Comment": "Discover RSS feeds, process them with bounded concurrency, refresh JSON, and report partial failures",
  "StartAt": "Prepare Feed Run",
  "States": {
    "Prepare Feed Run": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": 45,
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Parameters": { "FunctionName": "${rsscrawl}", "Payload": { "msg.$": "$" } },
      "Next": "Process Feeds"
    },
    "Process Feeds": {
      "Type": "Map",
      "ItemsPath": "$.results",
      "MaxConcurrency": 8,
      "Next": "Refresh Combined Article Index",
      "ItemSelector": {
        "msg.$": "$$.Map.Item.Value",
        "sendemail.$": "$.sendemail"
      },
      "ResultPath": "$.feedResults",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Import New Articles",
        "States": {
          "Import New Articles": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "TimeoutSeconds": 330,
            "ResultPath": "$.result",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "States.Timeout"
                ],
                "IntervalSeconds": 2,
                "BackoffRate": 2,
                "MaxAttempts": 3
              }
            ],
            "Parameters": {
              "FunctionName": "${rssgetfeed}",
              "Payload": { "msg.$": "$.msg", "sendemail.$": "$.sendemail" }
            },
            "Next": "Feed Succeeded",
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.error",
                "Next": "Feed Failed"
              }
            ]
          },
          "Feed Succeeded": {
            "Type": "Pass",
            "Parameters": {
              "status": "succeeded",
              "blogsource.$": "$.msg.blogsource",
              "counts.$": "$.result.Payload"
            },
            "End": true
          },
          "Feed Failed": {
            "Type": "Pass",
            "Parameters": {
              "status": "failed",
              "blogsource.$": "$.msg.blogsource",
              "error.$": "$.error"
            },
            "End": true
          }
        }
      }
    },
    "Refresh Combined Article Index": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": 330,
      "ResultPath": "$.allRefresh",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Parameters": { "FunctionName": "${rssgetfeed}", "Payload": { "msg": "all", "daystoretrieve.$": "$.daystoretrieve" } },
      "Next": "Check Feed Results"
    },
    "Check Feed Results": {
      "Type": "Choice",
      "QueryLanguage": "JSONata",
      "Choices": [
        {
          "Condition": "{% $count($states.input.feedResults[status = 'failed']) > 0 %}",
          "Next": "Feed Failure"
        }
      ],
      "Default": "Run Completed"
    },
    "Feed Failure": {
      "Type": "Fail",
      "Error": "FeedItemsFailed",
      "Cause": "One or more RSS feeds failed after retries; all.json was refreshed for the feeds that completed."
    },
    "Run Completed": {
      "Type": "Succeed"
    }
  }
}
